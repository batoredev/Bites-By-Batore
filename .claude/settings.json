{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/sriva/.local/bin/graphify.EXE hook-guard search"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/sriva/.local/bin/graphify.EXE hook-guard read"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/sriva/AppData/Local/Programs/Python/Python312/python.exe \"C:/Users/sriva/Desktop/insta glg gmap bot/scripts/graphify_refresh.py\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
