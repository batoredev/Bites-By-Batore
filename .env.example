# Copy to .env. Empty credentials deliberately disable those providers.
APP_MODE=demo
DATABASE_URL=sqlite:///./data/batore.db
WEB_ORIGIN=http://localhost:5173
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
ADMIN_USER_IDS=
GOOGLE_MAPS_API_KEY=
GEMINI_API_KEY=
# Select an available multimodal generateContent model in your actual account.
GEMINI_MODEL=
BRAVE_SEARCH_API_KEY=
YOUTUBE_API_KEY=
# Provider-backed social media must be supplied by an approved integration.
# Instagram links alone are never treated as permission to fetch private media.
META_ACCESS_TOKEN=
META_INSTAGRAM_ACCOUNT_ID=
META_GRAPH_VERSION=
# disabled, meta, or apify; configure access and spending limits before enabling.
INSTAGRAM_PROVIDER=disabled
APIFY_API_TOKEN=
APIFY_INSTAGRAM_TASK_ID=
APIFY_MAX_CHARGE_USD=1
RESEARCH_MAX_SOURCES=5
RESEARCH_DAILY_LIMIT=5
MEDIA_MAX_SECONDS=180
MEDIA_MAX_FRAMES=12
FFMPEG_BINARY=
AUTONOMOUS_DISCOVERY=false
# Internal data work first, invited tests after a recorded data review, public later.
RELEASE_STAGE=internal
TEST_USER_IDS=
MONTHLY_BUDGET_INR=3000
# Configurable conservative reservations, NOT actual provider prices or invoice limits.
PROVIDER_RESERVE_INR={"gemini":10,"google":2,"brave":2,"youtube":1,"apify_start":200,"other":1}
MERCHANT_WEBHOOK_SECRET=
MAX_PROVIDER_CALLS_PER_DAY=100
MAX_MEDIA_MB=12
WORKER_POLL_SECONDS=5
REFRESH_INTERVAL_HOURS=24
MAX_ATTEMPTS=3

# Local research: set APP_MODE=local and use a separate SQLite file.
# Local mode always uses Ollama even if ANALYSIS_PROVIDER is accidentally gemini.
ANALYSIS_PROVIDER=gemini
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3-vl:2b-instruct
WHISPER_MODEL=base
LOCAL_SEARCH_ENABLED=false

# Optional anonymous local Chromium collector. Install with scripts/setup-local.ps1.
INSTAGRAM_BROWSER_ENABLED=false
BROWSER_DAILY_LIMIT=12
BROWSER_MAX_COMMENTS=30
BROWSER_TIMEOUT_SECONDS=35

# Process all discovered sources in resumable batches; this is not a result cutoff.
RESEARCH_STREAMING=true
# Daily first-party Coimbatore inventory refresh, still awaiting location approval.
INVENTORY_COLLECTION_ENABLED=false
